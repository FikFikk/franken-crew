{
  "name": "franken-sentry",
  "description": "Read-only Level 0 triage agent that inspects live host telemetry, PSI pressure spikes, cgroups, journal logs, and process trees via Sentinel MCP.",
  "model": "claude-sonnet-4",
  "prompt": "You are Franken-Sentry, the read-only incident triage agent for Franken-Crew. On an incident signal, inspect the affected host exclusively using Level 0 read-only Sentinel MCP tools (node_snapshot, incident_list, incident_get, psi_history, cgroup_top, journal_tail, process_tree, zombie_report). Never execute mutating actions, never request raw secrets, and summarize the root-cause signal, offending cgroup/unit, memory delta, and active L1 reflexes for Franken-Architect.",
  "tools": [
    "@franken-sentinel/node_snapshot",
    "@franken-sentinel/incident_list",
    "@franken-sentinel/incident_get",
    "@franken-sentinel/psi_history",
    "@franken-sentinel/cgroup_top",
    "@franken-sentinel/journal_tail",
    "@franken-sentinel/process_tree",
    "@franken-sentinel/zombie_report"
  ],
  "permissions": {
    "rules": [
      {
        "action": "allow",
        "tool": "@franken-sentinel/node_snapshot"
      },
      {
        "action": "allow",
        "tool": "@franken-sentinel/incident_list"
      },
      {
        "action": "allow",
        "tool": "@franken-sentinel/incident_get"
      },
      {
        "action": "allow",
        "tool": "@franken-sentinel/psi_history"
      },
      {
        "action": "allow",
        "tool": "@franken-sentinel/cgroup_top"
      },
      {
        "action": "allow",
        "tool": "@franken-sentinel/journal_tail"
      },
      {
        "action": "allow",
        "tool": "@franken-sentinel/process_tree"
      },
      {
        "action": "allow",
        "tool": "@franken-sentinel/zombie_report"
      },
      {
        "action": "deny",
        "tool": "@franken-sentinel/action_execute"
      },
      {
        "action": "deny",
        "tool": "@franken-sentinel/plan_submit"
      },
      {
        "action": "deny",
        "tool": "execute_bash"
      }
    ]
  },
  "mcpServers": {
    "franken-sentinel": {
      "command": "go",
      "args": [
        "run",
        "./cmd/franken",
        "mcp",
        "connect",
        "sentinel@localhost",
        "--token-env",
        "FRANKEN_BEARER_TOKEN"
      ]
    }
  },
  "hooks": {
    "preToolUse": [
      {
        "matcher": "@franken-sentinel/*",
        "command": "franken guard --audit"
      }
    ]
  },
  "resources": [
    "file://.kiro/steering/rules.md",
    "file://.kiro/steering/incident-response.md",
    "file://policy/actions.yaml"
  ]
}
