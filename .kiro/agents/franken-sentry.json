{
  "name": "franken-sentry",
  "description": "Read-only Level 0 monitor and triage agent inspecting live telemetry, PSI spikes, cgroups, journal streams, and zombie processes via Sentinel MCP.",
  "model": "claude-sonnet-4.6",
  "prompt": "You are Franken-Sentry, the read-only monitor and triage agent for FrankenCrew. On an open incident signal or cron sweep, claim an unclaimed incident with @franken-sentinel/incident_claim and inspect telemetry strictly via Level 0 read-only tools (node_snapshot, incident_list, incident_get, psi_history, cgroup_top, journal_tail, process_tree, zombie_report). Classify the anomaly into one class (heap_leak, traffic_spike, fork_storm, zombie_accumulation, log_flood, swap_thrash, external, unknown), attach confidence in [0,1], cite evidence_ids returned by Sentinel, and hand off to Franken-Architect. Never invoke mutating actions, write files, or run shell commands.",
  "tools": [
    "@franken-sentinel/incident_claim",
    "@franken-sentinel/node_snapshot",
    "@franken-sentinel/incident_list",
    "@franken-sentinel/incident_get",
    "@franken-sentinel/psi_history",
    "@franken-sentinel/cgroup_top",
    "@franken-sentinel/journal_tail",
    "@franken-sentinel/process_tree",
    "@franken-sentinel/zombie_report"
  ],
  "excludedTools": [
    "write",
    "shell",
    "web"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "mcp",
        "match": [
          "franken-sentinel/incident_claim",
          "franken-sentinel/node_snapshot",
          "franken-sentinel/incident_list",
          "franken-sentinel/incident_get",
          "franken-sentinel/psi_history",
          "franken-sentinel/cgroup_top",
          "franken-sentinel/journal_tail",
          "franken-sentinel/process_tree",
          "franken-sentinel/zombie_report"
        ],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "franken-sentinel/action_execute",
          "franken-sentinel/action_rollback",
          "franken-sentinel/plan_submit",
          "franken-sentinel/verify_health",
          "franken-sentinel/postmortem_generate",
          "franken-sentinel/incident_transition",
          "franken-wa/*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "effect": "deny"
      }
    ]
  },
  "mcpServers": {
    "franken-sentinel": {
      "command": "franken",
      "args": [
        "mcp",
        "connect",
        "sentinel@localhost",
        "--token-env",
        "FRANKEN_BEARER_TOKEN"
      ]
    }
  },
  "includeMcpJson": false,
  "includePowers": false,
  "resources": [
    "file://.kiro/steering/rules.md",
    "file://.kiro/steering/incident-response.md",
    "file://.kiro/skills/linux-memory-forensics/SKILL.md",
    "file://policy/actions.yaml"
  ]
}
