# Salin berkas ini ke /etc/franken/franken.env dengan hak akses 0600 (root:root)
# Token autentikasi Bearer antara wa-bridge, Kiro Crew, dan Sentinel HTTP/SSE MCP
FRANKEN_BEARER_TOKEN=ganti-dengan-token-acak-min-32-karakter

# URL dasar Sentinel di interface Tailscale atau loopback
FRANKEN_SENTINEL_URL=http://100.64.0.10:8090

# Daftar nomor WhatsApp atau JID admin yang diizinkan (pisahkan dengan koma)
FRANKEN_WA_ADMINS=+6281234567890

# Webhook Kiro Crew untuk alur event-driven: incident.opened -> TRIAGE, vote disetujui -> EXECUTE.
# Kosongkan untuk menonaktifkan; cron incident-sweep (15 menit) tetap menjadi jaring pengaman.
FRANKEN_CREW_WEBHOOK_URL=http://127.0.0.1:5476/api/hooks/agent

# Bearer token webhook Crew, buat dengan `kirocrew token`
KIROCREW_TOKEN=ganti-dengan-token-kirocrew
