[Unit]
Description=FrankenCrew Sentinel Daemon (Kernel PSI Telemetry, L1 Reflex & MCP Server)
Documentation=https://github.com/FikFikk/franken-crew
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/franken/franken.env
RuntimeDirectory=franken
StateDirectory=franken
ExecStart=/usr/local/bin/franken sentinel serve --tailscale --port 8090 --db /var/lib/franken/franken-sentinel.db --policy /etc/franken/policy/actions.yaml --pub-key /etc/franken/keys/sentinel-ed25519.pub --postmortem-dir /var/lib/franken/incidents --token-env FRANKEN_BEARER_TOKEN
Restart=always
RestartSec=2s
TimeoutStopSec=15s

# Proteksi OOM & batasan memori ketat agar Sentinel bertahan saat node mengalami tekanan memori ekstrem
OOMScoreAdjust=-900
MemoryMin=32M
MemoryHigh=42M
MemoryMax=48M
CPUWeight=200

# Sandboxing filesystem & privilege minimal sesuai standar hardening systemd
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
PrivateDevices=yes
ProtectControlGroups=no
# Aksi L2 PM2 didelegasikan ke unit transien via systemd-run agar keluar dari cgroup 48M & ProtectHome Sentinel
Environment=FRANKEN_PM2_USER=pi
Environment=FRANKEN_PM2_HOME=/home/pi/.pm2
EnvironmentFile=-/etc/franken/sentinel.env
ReadWritePaths=/sys/fs/cgroup /var/lib/franken /run/franken

# Isolasi namespace jaringan ke AF_UNIX (D-Bus systemd-run/journald) dan IPv4/IPv6 (Tailscale & loopback)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

